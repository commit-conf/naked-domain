{
  "hosting": {
    "public": "website",
    "ignore": [
      "firebase.json",
      "README.md",
      "package.json",
      "package-lock.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://2024.commit-conf.com",
        "type": 302
      },
      {
        "source": "/**",
        "destination": "https://2024.commit-conf.com",
        "type": 302
      }
    ]
  }
}
